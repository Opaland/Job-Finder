# ============================================================
#  Job Finder — configuration
#  Copie ce fichier en « .env » à la racine du projet, puis
#  remplis les clés au fur et à mesure (guide détaillé : README §3)
# ============================================================

# --- France Travail (ex Pôle Emploi) — API officielle gratuite ---
# 1. Crée un compte sur https://francetravail.io
# 2. Crée une application et coche l'API « Offres d'emploi v2 »
# 3. Copie l'identifiant client et la clé secrète ci-dessous
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Adzuna — agrégateur, API officielle gratuite ---
# https://developer.adzuna.com → « Sign up » → les clés sont affichées dans le dashboard
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- JSearch via RapidAPI — couvre LinkedIn / Indeed / Glassdoor (Google for Jobs) ---
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch → « Subscribe to test » (plan Basic gratuit)
# puis copie la valeur « X-RapidAPI-Key »
RAPIDAPI_KEY=

# --- Welcome to the Jungle (facultatif) ---
# Fonctionne sans rien remplir. Si la source tombe en erreur 4xx, récupère la clé
# publique du site : F12 → Réseau → requête « algolia » → en-tête x-algolia-api-key
WTTJ_ALGOLIA_API_KEY=

# --- Email quotidien (digest) ---
# Avec Gmail : active la validation en 2 étapes puis crée un « mot de passe d'application »
# sur https://myaccount.google.com/apppasswords et colle-le dans SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ced.moretti@gmail.com
SMTP_PASSWORD=
DIGEST_EMAIL_TO=ced.moretti@gmail.com

# --- IA locale via ta session Claude Code ---
# "auto" : utilise la CLI « claude » si elle est installée sur le poste ; "off" pour désactiver
AI_MODE=auto
CLAUDE_CLI=claude
AI_MAX_OFFERS_PER_SCAN=15
AI_MIN_RULE_SCORE=45

# --- Scan quotidien ---
SCAN_HOUR=07:30
TIMEZONE=Europe/Paris

# --- Serveur local ---
HOST=127.0.0.1
PORT=8000
